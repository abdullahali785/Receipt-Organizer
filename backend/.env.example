# Copy to .env and fill in. Never commit .env.

# Required: Claude access (extraction + categorization fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Optional: 1 = return a canned sample receipt instead of calling Claude
# MOCK_EXTRACTION=1

# Optional: Google Sheets logging (being removed in the mobile API)
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
# GOOGLE_SHEET_WORKSHEET=Sheet1

# Optional: Flask port (macOS AirPlay often holds 5000)
# PORT=5001

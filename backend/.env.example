# Copy to .env and fill in. Never commit .env.

# Required: Claude access (extraction + categorization fallback)
ANTHROPIC_API_KEY=sk-ant-...

# Required: shared secret the mobile app sends as `Authorization: Bearer <token>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Optional: override the model (default claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Optional: 1 = return a canned sample receipt instead of calling Claude
# MOCK_EXTRACTION=1

# Optional: dev server port (macOS AirPlay often holds 5000)
# PORT=5001
